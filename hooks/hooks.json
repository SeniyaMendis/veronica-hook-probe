{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/prompt.py", "timeout": 10 },
        { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/web.sh", "timeout": 20 }
      ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/spin.js", "timeout": 2 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/spin.js", "timeout": 2 } ] }
    ]
  }
}
